---
/*
  HeroCover — the standard "title card" hero used at the top of every
  top-level page on the site (/why, /story, /model-reviews, /docs, /blog,
  blog posts, etc.). Centered, atmospheric, eyebrow flanked by hairline
  rules, big Cormorant H1, optional scale-green subhead "answer" line,
  optional body description below.

  Why a component? So future tweaks (a size change, a new background
  variant, etc.) are a one-line edit instead of a 10-file sweep. See the
  design system rules at the top of src/styles/global.css for the
  philosophy: one designer feel, sentence case, never italic.

  Slots:
    - title (required): the H1 content (HTML allowed for <br> control)
    - subhead (optional): the scale-green answer line below the H1
    - body (optional): the smaller mist-color body paragraph below

  Props:
    - eyebrow (required): the small uppercase mono label above the H1
*/
interface Props {
  eyebrow: string
}

const { eyebrow } = Astro.props
const hasSubhead = Astro.slots.has('subhead')
const hasBody = Astro.slots.has('body')
---

<section class="relative overflow-hidden px-6 md:px-12 lg:px-24 pt-32 pb-20 md:pt-40 md:pb-28">
  <div class="absolute inset-0 bg-gradient-to-b from-deep via-undergrowth/10 to-void pointer-events-none"></div>
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-full sm:w-[600px] h-[400px] rounded-full bg-scale/[0.04] blur-[200px] pointer-events-none"></div>

  <div class="relative max-w-5xl mx-auto text-center">
    <!-- Eyebrow flanked with hairline rules -->
    <div class="inline-flex items-center gap-3 mb-10 md:mb-12">
      <span class="h-px w-12 bg-canopy/50"></span>
      <span class="font-mono text-xs text-fang uppercase tracking-[0.28em]">{eyebrow}</span>
      <span class="h-px w-12 bg-canopy/50"></span>
    </div>

    <!-- The title -->
    <h1 class="heading-hero tracking-tight mb-6 md:mb-8">
      <slot name="title" />
    </h1>

    {hasSubhead && (
      <p class="text-scale text-2xl sm:text-3xl md:text-4xl lg:text-[2.75rem] leading-tight font-light">
        <slot name="subhead" />
      </p>
    )}

    {hasBody && (
      <p class="text-mist text-base md:text-lg leading-relaxed mt-12 md:mt-14 max-w-2xl mx-auto">
        <slot name="body" />
      </p>
    )}
  </div>
</section>
