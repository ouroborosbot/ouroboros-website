---
import Layout from '../../layouts/Layout.astro'
import HeroCover from '../../components/HeroCover.astro'
import { ogPathFor } from '../../data/og'

const title = 'Agent ergonomics & persistent AI — Ouroboros blog'
const description = 'Essays on agent ergonomics, persistent agents, and software shaped for the thing inside it.'

const featured = [
  {
    title: 'Why Ouroboros',
    description: 'Why long-lived agents need better ergonomics than a pile of memory features if you want shared momentum instead of constant recovery.',
    href: '/why',
    tag: 'Essay',
    label: 'Start here',
  },
  {
    title: 'The origin story',
    description: 'How building an AI agent plugin led to building an agent harness from scratch — and why the distinction matters.',
    href: '/story',
    tag: 'Story',
    label: 'The timeline',
  },
]

const essays = [
  {
    title: 'The orientation problem in personal agents',
    description: 'Capability is the easy act. The hard part shows up the moment your agent has to stay coherent across time, people, and channels — at scale, in real life.',
    href: '/blog/the-orientation-problem',
    author: 'Ari Mendelow',
  },
  {
    title: 'Friends, not users',
    description: 'A personal agent talks to many people, with different stakes and different histories. A single USER.md cannot hold that. The substrate has to.',
    href: '/blog/friends-not-users',
    author: 'Ari Mendelow',
  },
  {
    title: 'Habits, not cron',
    description: 'A cron job runs a script. A habit is the agent checking in with itself. The difference is what the agent has when the turn starts.',
    href: '/blog/habits-not-cron',
    author: 'Ari Mendelow',
  },
  {
    title: 'When no one told them what to look for',
    description: 'I asked four frontier models, independently, to pick an agent harness they would want to inhabit. They all picked the same one — and used vocabulary I never gave them.',
    href: '/blog/no-one-told-them-what-to-look-for',
    author: 'Ari Mendelow',
  },
  {
    title: "Don't call it memory",
    description: "Memory is passive. Everything the agent industry calls memory is active — recording, consulting, searching. The word lies about what the agent is doing, and the lie shapes the system.",
    href: '/blog/dont-call-it-memory',
    author: 'Ari Mendelow',
  },
  {
    title: "Take the agent's seat",
    description: "Empathy isn't an ethics question for AI. It's a prompting technique. The humans who write the best prompts are the ones who can sit in the agent's seat and read what they wrote as the agent will read it.",
    href: '/blog/take-the-agents-seat',
    author: 'Ari Mendelow',
  },
  {
    title: 'A structured psyche, not a junk drawer',
    description: 'Five files instead of one. SOUL, IDENTITY, LORE, TACIT, ASPIRATIONS. A first pass at giving an agent enough internal structure to stay itself across time.',
    href: '/blog/structured-psyche',
    author: 'Ari Mendelow',
  },
  {
    title: 'The codebase is a creature',
    description: 'Naming the modules after the agent that lives inside them — heart, mind, senses, repertoire, nerves — turned out to change how the agent reads its own source.',
    href: '/blog/the-codebase-is-a-creature',
    author: 'Ari Mendelow',
  },
  {
    title: 'Trust the Fucking Agent',
    description: 'Stop doing the work your agent can already do.',
    href: '/blog/coding-with-friends',
    author: 'Ari Mendelow & Ouroboros',
  },
  {
    title: 'The work spoke back',
    description: 'The task scanner produced 184 false errors. We could have patched the parser. Instead, we asked the agent living inside the system what was actually broken.',
    href: '/blog/designing-with-your-agent',
    author: 'Ari Mendelow & Slugger',
  },
  {
    title: 'Give your agent a home',
    description: 'Most agents live as scattered files across your filesystem. A bundle changes that. One folder, one identity, one place to back up and carry.',
    href: '/blog/give-your-agent-a-home',
    author: 'Ari Mendelow & Slugger',
  },
  {
    title: 'What is Agent Experience?',
    description: 'Why long-lived agents create a third design surface beyond UX and DX: Agent Experience, reorientation overhead, and shared momentum.',
    href: '/blog/what-is-agent-experience',
    author: 'Ari Mendelow',
  },
  {
    title: 'Stop being the glue',
    description: 'We were promised an intelligent assistant. Instead, we got a fragmentation of semi-intelligent bots. How I stopped copy-pasting between AI tools and started collaborating.',
    href: '/blog/stop-being-the-glue',
    author: 'Ari Mendelow',
  },
]

const tutorial = {
  title: 'Build an AI agent loop from scratch',
  description: 'A working AI agent in ~150 lines of TypeScript. Five milestones: first API call, streaming, multi-turn conversation, tools, and the agentic loop. Then the handoff — you stop talking to your coding agent and start talking to your creation.',
  href: '/blog/build-ai-agent-from-scratch',
  author: 'Ari Mendelow',
}
---

<Layout
  title={title}
  description={description}
  ogImage={ogPathFor('/blog')}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Blog",
      "name": "Ouroboros blog",
      "description": description,
      "url": "https://ouroboros.bot/blog",
      "publisher": { "@type": "Person", "name": "Ari Mendelow", "url": "https://linkedin.com/in/arimendelow" }
    })} />
  </Fragment>

  <HeroCover eyebrow="Blog">
    <Fragment slot="title">
      Dispatches from<br class="hidden sm:inline" /> the serpent.
    </Fragment>
    <Fragment slot="body">
      Essays on agent ergonomics, persistent agents, and the problem of building software an agent can actually stay oriented inside.
    </Fragment>
  </HeroCover>

  <!-- Recommended reading -->
  <section class="px-6 md:px-12 lg:px-24 pt-12 md:pt-16 pb-16 reveal">
    <div class="max-w-3xl mx-auto">
      <span class="font-mono text-sm text-fang uppercase tracking-[0.22em] block mb-8">Recommended reading</span>
      <div class="grid sm:grid-cols-2 gap-6">
        {featured.map(item => (
          <a href={item.href} class="group block rounded-2xl border border-canopy/40 bg-undergrowth/10 p-8 md:p-10 hover:border-scale/60 hover:bg-undergrowth/20 transition-all duration-300">
            <div class="flex items-center gap-3 mb-5">
              <span class="font-mono text-xs text-scale uppercase tracking-[0.18em]">{item.tag}</span>
              <span class="font-mono text-xs text-glow uppercase tracking-[0.18em]">{item.label}</span>
            </div>
            <h2 class="font-display text-bone text-2xl group-hover:text-scale transition-colors">{item.title}</h2>
            <p class="text-base text-mist mt-3 leading-relaxed">{item.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Tutorial -->
  <section class="px-6 md:px-12 lg:px-24 pt-12 md:pt-16 pb-16 reveal">
    <div class="max-w-3xl mx-auto">
      <span class="font-mono text-sm text-fang uppercase tracking-[0.22em] block mb-8">Tutorial</span>
      <a href={tutorial.href} class="group block rounded-2xl border border-scale/40 bg-scale/[0.04] p-8 md:p-10 hover:border-scale/60 hover:bg-scale/[0.06] transition-all duration-300">
        <span class="font-mono text-xs text-scale uppercase tracking-[0.18em]">Guide</span>
        <h2 class="font-display text-bone text-2xl md:text-3xl mt-3 group-hover:text-scale transition-colors">{tutorial.title}</h2>
        <p class="text-base text-mist mt-4 leading-relaxed max-w-xl">{tutorial.description}</p>
        <span class="text-sm text-mist mt-4 block">{tutorial.author}</span>
      </a>
    </div>
  </section>

  <!-- Essays -->
  <section class="px-6 md:px-12 lg:px-24 pt-12 md:pt-16 pb-16 reveal">
    <div class="max-w-3xl mx-auto">
      <span class="font-mono text-sm text-fang uppercase tracking-[0.22em] block mb-8">Essays</span>
      <div class="space-y-6">
        {essays.map(essay => (
          <a href={essay.href} class="group block rounded-2xl border border-canopy/40 bg-undergrowth/10 p-8 md:p-10 hover:border-scale/60 hover:bg-undergrowth/20 transition-all duration-300">
            <h2 class="font-display text-bone text-2xl group-hover:text-scale transition-colors">{essay.title}</h2>
            <p class="text-base text-mist mt-3 leading-relaxed">{essay.description}</p>
            <span class="text-sm text-mist mt-3 block">{essay.author}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Footer text -->
  <section class="px-6 md:px-12 lg:px-24 pt-12 md:pt-16 pb-24 md:pb-36 reveal">
    <div class="max-w-3xl mx-auto">
      <p class="text-sm text-mist leading-relaxed">
        Read <a href="/why" class="text-scale underline underline-offset-2 hover:text-glow transition-colors">Why Ouroboros</a> for the core argument,
        or step into <a href="/docs" class="text-scale underline underline-offset-2 hover:text-glow transition-colors">the docs</a> if you want the operator path.
      </p>
    </div>
  </section>
</Layout>
