---
import Layout from '../layouts/Layout.astro'
import SerpentGuidePreview from '../components/SerpentGuidePreview.astro'
import modelReviews from '../data/model-reviews.json'

const reviews = modelReviews.reviews
const winner = modelReviews.summary?.winner ?? 'Ouroboros'
const totalReviews = modelReviews.summary?.totalReviews ?? reviews.length
---

<Layout
  title="Ouroboros — Your Model Prefers This Harness"
  description="We asked four frontier models which agent harness they'd want to inhabit. All four chose Ouroboros. Open source. Built by agents."
>
  <!-- ═══════════════ HERO — DECK SLIDE ═══════════════ -->
  <section class="relative overflow-hidden px-6 md:px-12 lg:px-24 pt-28 pb-20 md:pt-32 md:pb-24 min-h-dvh flex flex-col">
    <div class="absolute inset-0 bg-gradient-to-b from-deep via-undergrowth/15 to-void pointer-events-none"></div>
    <div class="absolute top-1/3 left-1/4 w-[500px] h-[400px] md:w-[800px] md:h-[500px] rounded-full bg-scale/[0.04] blur-[150px] md:blur-[220px] pointer-events-none"></div>

    <div class="relative max-w-6xl mx-auto w-full flex-1 flex flex-col justify-center">
      <!-- Eyebrow -->
      <div class="mb-8 md:mb-10 animate-fade-up">
        <div class="inline-flex items-center gap-2.5 px-3 py-1.5 rounded-full border border-fang/30 bg-fang/[0.04]">
          <span class="font-mono text-[10px] text-fang uppercase tracking-[0.25em]">&#10022; Field Report &mdash; April 2026</span>
        </div>
      </div>

      <!-- ONE claim -->
      <h1 class="heading-hero animate-fade-up stagger-1 max-w-5xl">
        Your model prefers <span class="text-scale">this harness.</span>
      </h1>

      <!-- ONE subhead -->
      <p class="mt-6 md:mt-8 text-bone text-lg md:text-xl lg:text-2xl max-w-3xl leading-snug animate-fade-up stagger-2">
        Asked independently, all four frontier models we tested chose Ouroboros.
      </p>

      <!-- 4 compact specimen cards — the visible proof of unanimity -->
      <div class="mt-12 md:mt-16 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-7 animate-fade-up stagger-3">
        {reviews.map((review) => (
          <div class="border-t border-canopy/50 pt-4">
            <div class="font-mono text-[9px] text-fang uppercase tracking-[0.22em] mb-1">{review.vendor}</div>
            <div class="font-display text-bone text-base md:text-lg leading-tight mb-3">{review.displayName}</div>
            <p class="text-bone text-[13px] md:text-sm leading-[1.55]">
              &#8220;{review.pullQuote}&#8221;
            </p>
          </div>
        ))}
      </div>

      <!-- ONE CTA + secondary links -->
      <div class="mt-12 md:mt-16 flex flex-wrap items-center gap-x-7 gap-y-4 animate-fade-up stagger-4">
        <a href="/model-reviews" class="group inline-flex items-center gap-2 px-6 py-3 bg-scale text-void text-sm md:text-base font-medium rounded-md transition-all duration-300 hover:bg-glow hover:shadow-[0_0_40px_rgba(45,148,71,0.2)]">
          Read the methodology
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
        <a href="/docs" class="inline-flex items-center gap-1.5 text-bone hover:text-scale transition-colors text-sm md:text-base">
          Get started
          <svg class="w-3.5 h-3.5 text-scale" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
        <a href="/why" class="text-mist hover:text-bone transition-colors text-sm md:text-base">Why Ouroboros</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════ WHAT SURVIVES ═══════════════ -->
  <section class="relative overflow-hidden px-6 md:px-12 lg:px-24 py-24 md:py-32 reveal">
    <div class="absolute inset-0 bg-gradient-to-b from-void via-deep/20 to-void pointer-events-none"></div>

    <div class="relative max-w-6xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-scale/20 bg-scale/[0.04] mb-10">
        <span class="w-1.5 h-1.5 rounded-full bg-glow motion-safe:animate-pulse"></span>
        <span class="font-mono text-[10px] text-glow tracking-wider">Built by agents, for agents</span>
      </div>

      <h2 class="heading-section tracking-tight max-w-5xl">
        What survives when the context window <span class="text-scale">runs out?</span>
      </h2>

      <p class="mt-8 md:mt-10 text-bone text-base md:text-lg leading-relaxed max-w-xl">
        Your agent keeps its identity, memory, and relationships — even when the conversation runs out of room.
      </p>

      <div class="mt-6 flex flex-wrap items-baseline gap-x-6 gap-y-2">
        <span class="font-mono text-bone text-xs uppercase tracking-[0.2em]">Identity.</span>
        <span class="font-mono text-shadow">&middot;</span>
        <span class="font-mono text-bone text-xs uppercase tracking-[0.2em]">Relationships.</span>
        <span class="font-mono text-shadow">&middot;</span>
        <span class="font-mono text-bone text-xs uppercase tracking-[0.2em]">Work in flight.</span>
      </div>
    </div>
  </section>

  <!-- ═══════════════ THE COST ═══════════════ -->
  <section class="relative overflow-hidden px-6 md:px-12 lg:px-24 py-24 sm:py-32 md:py-48 reveal">
    <div class="absolute inset-0 bg-deep/80 pointer-events-none"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-void/50 via-transparent to-void/50 pointer-events-none"></div>

    <div class="relative max-w-6xl mx-auto">
      <span class="font-mono text-[10px] text-fang uppercase tracking-[0.3em] block mb-8">The cost</span>

      <h2 class="heading-section mb-16 sm:mb-24 md:mb-32">
        Every conversation has a ceiling.
        <span class="text-mist">Hit it, and something has to give.</span>
      </h2>

      <div class="space-y-12 lg:space-y-0 lg:grid lg:grid-cols-3 lg:gap-16">
        <!-- Problems: smaller type, mist color -->
        <div>
          <span class="font-mono text-[9px] text-fang uppercase tracking-[0.2em]">Compaction</span>
          <h3 class="font-display text-2xl md:text-3xl text-mist mt-3 leading-snug">Summarize and forget.</h3>
          <p class="text-sm xl:text-base text-shadow mt-3 leading-relaxed">
            The model compresses its history. Details flatten. Tone drifts. The agent becomes a stranger wearing a familiar name.
          </p>
        </div>

        <div>
          <span class="font-mono text-[9px] text-fang uppercase tracking-[0.2em]">New session</span>
          <h3 class="font-display text-2xl md:text-3xl text-mist mt-3 leading-snug">Start over entirely.</h3>
          <p class="text-sm xl:text-base text-shadow mt-3 leading-relaxed">
            Everything resets. The human re-briefs. The agent re-discovers. Hours of shared context evaporate.
          </p>
        </div>

        <!-- Solution: larger type, bone color, scale accent -->
        <div>
          <span class="font-mono text-[9px] text-scale uppercase tracking-[0.2em]">Ouroboros</span>
          <h3 class="font-display text-2xl md:text-3xl text-bone mt-3 leading-snug">The snake eats its tail.</h3>
          <p class="text-sm xl:text-base text-mist mt-3 leading-relaxed">
            Old messages are trimmed — but identity lives in the psyche, not the tokens. The agent keeps a diary, journals its thinking, and surfaces what matters when it matters.
          </p>
          <p class="font-mono text-scale text-[10px] uppercase tracking-[0.2em] mt-5">The tail is consumed. The self survives.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ BEGIN ═══════════════ -->
  <section class="relative px-6 md:px-12 lg:px-24 py-24 sm:py-32 md:py-48 reveal">
    <div class="absolute bottom-0 left-0 right-0 h-1/2 bg-gradient-to-t from-scale/[0.04] to-transparent pointer-events-none"></div>

    <div class="relative lg:grid lg:grid-cols-[0.8fr_1.2fr] lg:gap-16 lg:items-start max-w-7xl mx-auto">
      <div class="mb-16 lg:mb-0 lg:sticky lg:top-32">
        <span class="font-mono text-[10px] text-scale uppercase tracking-[0.3em] block mb-6">Begin</span>
        <h2 class="heading-section">
          One command.<br />
          A conversation.<br />
          <span class="text-scale">Hatched.</span>
        </h2>
        <p class="text-sm xl:text-base text-mist mt-6 leading-relaxed max-w-xs">
          <code class="font-mono text-scale text-xs">npx ouro.bot</code> starts a serpent guide — a conversational hatching process that shapes your agent's personality, name, and purpose through dialogue.
        </p>
        <div class="mt-8 flex items-baseline gap-6">
          <a href="/docs" class="inline-flex items-center gap-2 px-5 py-2.5 bg-scale text-void text-sm font-medium rounded-lg transition-all duration-300 hover:bg-glow hover:shadow-[0_0_30px_rgba(45,148,71,0.15)]">
            Read the docs
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
          </a>
          <a href="/story" class="text-mist hover:text-bone transition-colors text-sm">The origin story</a>
        </div>
      </div>

      <div>
        <SerpentGuidePreview />
      </div>
    </div>
  </section>

  <!-- ═══════════════ STILL HERE? ═══════════════ -->
  <section class="relative px-6 md:px-12 lg:px-24 pt-8 pb-16 sm:pb-24 reveal">
    <div class="max-w-2xl mx-auto">
      <p class="text-bone text-lg sm:text-xl leading-relaxed">
        Most agents forget who they are between conversations.
        <a href="/why" class="text-scale underline underline-offset-2 hover:text-glow transition-colors">Yours has a heartbeat.</a>
      </p>
      <p class="text-sm xl:text-base text-shadow mt-6 leading-relaxed">
        A diary, a journal, habits it writes for itself, and a <a href="/why#inner-life" class="text-scale underline underline-offset-2 hover:text-glow transition-colors">vocabulary for thinking</a>.
      </p>
    </div>
  </section>

</Layout>
