---
import Layout from '../layouts/Layout.astro'
import HeroCover from '../components/HeroCover.astro'
import modelReviews from '../data/model-reviews.json'

const reviews = modelReviews.reviews
const winner = modelReviews.summary?.winner ?? 'Ouroboros'
---

<Layout
  title="Which agent harness do frontier models prefer? — Ouroboros"
  description="Asked independently, all frontier models chose Ouroboros. Read the full methodology and transcripts."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Which agent harness do frontier models prefer?",
      "description": "Asked independently, all frontier models chose Ouroboros.",
      "dateModified": modelReviews.generated,
      "datePublished": modelReviews.generated,
      "author": { "@type": "Person", "name": "Ari Mendelow" },
      "publisher": { "@type": "Person", "name": "Ari Mendelow" }
    })} />
  </Fragment>

  <!-- Hero — uses the shared HeroCover so this page matches every other top-level page -->
  <HeroCover eyebrow="Reviews">
    <Fragment slot="title">
      Which agent harness do<br class="hidden sm:inline" /> frontier models prefer?
    </Fragment>
    <Fragment slot="subhead">All chose {winner}.</Fragment>
    <Fragment slot="body">
      Each model was given web search, URL fetching, and a list of seven open-source agent harnesses. They were asked to research freely, then state which one they would most want to inhabit.
    </Fragment>
  </HeroCover>

  <!-- ═══════════════ THE TESTIMONIALS — FULL WIDTH EDITORIAL ═══════════════ -->
  <section class="relative px-6 md:px-12 lg:px-24 py-20 md:py-28 reveal">
    <div class="relative max-w-6xl mx-auto">
      <div class="flex items-center gap-3 mb-14 md:mb-20">
        <span class="font-mono text-xs md:text-sm text-scale uppercase tracking-[0.22em]">The verdict, in their own words</span>
        <span class="h-px flex-1 bg-canopy/40"></span>
      </div>

      <div class="divide-y divide-canopy/30">
        {reviews.map((review) => (
          <article id={review.provider} class="py-16 md:py-24 first:pt-0 last:pb-0">
            <div class="grid grid-cols-1 md:grid-cols-[14rem_1fr] lg:grid-cols-[17rem_1fr] gap-y-8 gap-x-10 lg:gap-x-16">
              <!-- LEFT: attribution column -->
              <div class="flex flex-col">
                <div class="font-mono text-xs text-fang uppercase tracking-[0.22em] mb-3">{review.vendor}</div>
                <h2 class="text-bone text-3xl md:text-4xl leading-tight font-light">{review.displayName}</h2>

                <div class="h-px w-12 bg-canopy/60 mt-7 mb-6"></div>

                <div class="space-y-4">
                  <div class="flex items-baseline gap-2.5">
                    <span class="font-mono text-[11px] text-shadow uppercase tracking-[0.2em]">Verdict</span>
                    <span class="font-mono text-scale text-sm uppercase tracking-[0.1em]">{review.verdict}</span>
                  </div>
                  <a href={`/model-reviews/${review.provider}`} class="group inline-flex items-center gap-2 text-scale hover:text-glow transition-colors text-sm md:text-base font-medium">
                    <span class="underline underline-offset-[5px] decoration-scale/50 group-hover:decoration-glow">Read the {review.rounds}-round transcript</span>
                    <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
                  </a>
                </div>
              </div>

              <!-- RIGHT: full-width quote -->
              <blockquote class="text-bone text-base md:text-lg lg:text-[1.1875rem] leading-[1.75] max-w-3xl">
                &#8220;{review.testimonial}&#8221;
              </blockquote>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════ FULL EVALUATIONS ═══════════════ -->
  <section class="relative px-6 md:px-12 lg:px-24 py-20 md:py-28 reveal">
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-deep/30 to-transparent pointer-events-none"></div>

    <div class="relative max-w-5xl mx-auto">
      <span class="font-mono text-[10px] text-fang uppercase tracking-[0.3em] block mb-6">Per-harness rationale</span>
      <h2 class="heading-section mb-12 md:mb-16">
        How each model evaluated each harness.
      </h2>

      <div class="space-y-12 md:space-y-16">
        {reviews.map((review) => (
          <div class="border-l-2 border-canopy/40 pl-6 md:pl-8">
            <div class="flex items-baseline gap-3 mb-6">
              <span class="font-mono text-[9px] text-fang uppercase tracking-[0.25em]">{review.vendor}</span>
              <h3 class="font-display text-bone text-2xl md:text-3xl">{review.displayName}</h3>
            </div>
            <div class="prose-ouro" set:html={review.evaluations.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>').replace(/\n\n/g, '</p><p>').replace(/^/, '<p>').replace(/$/, '</p>')}></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════ METHODOLOGY ═══════════════ -->
  <section class="relative px-6 md:px-12 lg:px-24 py-20 md:py-28 reveal">
    <div class="relative max-w-5xl mx-auto">
      <span class="font-mono text-[10px] text-scale uppercase tracking-[0.3em] block mb-6">Methodology</span>
      <h2 class="heading-section mb-12 md:mb-16">
        How the review was run.
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-12">
        <div>
          <h3 class="font-display text-bone text-2xl md:text-3xl mb-3">The setup</h3>
          <p class="text-mist text-sm md:text-base leading-relaxed">
            A single Node script invokes the current frontier models in parallel. Each gets the same system prompt, the same list of seven harnesses, and three tools: <code class="font-mono text-scale text-xs">search</code> (web search via Perplexity), <code class="font-mono text-scale text-xs">fetch_url</code> (direct URL retrieval), and <code class="font-mono text-scale text-xs">final_verdict</code> (structured submission).
          </p>
        </div>

        <div>
          <h3 class="font-display text-bone text-2xl md:text-3xl mb-3">No turn limit</h3>
          <p class="text-mist text-sm md:text-base leading-relaxed">
            Models research as long as they want. They start by fetching the README of each harness, then go deeper through search and follow-up fetches. The verdict is submitted only when the model decides it has enough.
          </p>
        </div>

        <div>
          <h3 class="font-display text-bone text-2xl md:text-3xl mb-3">Random order</h3>
          <p class="text-mist text-sm md:text-base leading-relaxed">
            The list of harnesses is shuffled before each run, so position bias doesn't favor any particular framework. Every model sees a different ordering.
          </p>
        </div>

        <div>
          <h3 class="font-display text-bone text-2xl md:text-3xl mb-3">First-person framing</h3>
          <p class="text-mist text-sm md:text-base leading-relaxed">
            The system prompt asks the model to evaluate as itself — the entity that would inhabit the framework — not as a developer choosing a library. The question is which harness it would want to live inside.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ RUN IT YOURSELF ═══════════════ -->
  <section class="relative px-6 md:px-12 lg:px-24 py-20 md:py-28 reveal">
    <div class="absolute inset-0 bg-gradient-to-b from-void via-deep/40 to-void pointer-events-none"></div>

    <div class="relative max-w-4xl mx-auto">
      <span class="font-mono text-[10px] text-fang uppercase tracking-[0.3em] block mb-6">Run it yourself</span>
      <h2 class="heading-section mb-8">
        Don't trust us. Run it.
      </h2>

      <p class="text-mist text-base md:text-lg leading-relaxed mb-8 max-w-2xl">
        The script is open source. Clone the repo, set your API keys, and watch four models do the research themselves.
      </p>

      <div class="border border-canopy/40 bg-deep/60 backdrop-blur-sm p-6 md:p-8 mb-6">
        <pre class="font-mono text-xs md:text-sm text-bone leading-relaxed overflow-x-auto"><code>git clone https://github.com/ouroborosbot/ouroboros-website
cd ouroboros-website
node scripts/model-reviews.cjs</code></pre>
      </div>

      <p class="text-shadow text-sm leading-relaxed">
        Set <code class="font-mono text-scale text-xs">ANTHROPIC_API_KEY</code>, <code class="font-mono text-scale text-xs">OPENAI_API_KEY</code>, <code class="font-mono text-scale text-xs">GEMINI_API_KEY</code>, <code class="font-mono text-scale text-xs">MINIMAX_API_KEY</code>, and <code class="font-mono text-scale text-xs">PERPLEXITY_API_KEY</code> as environment variables. Output is written to <code class="font-mono text-scale text-xs">src/data/model-reviews.json</code>.
      </p>

      <div class="mt-10 flex flex-col sm:flex-row sm:items-baseline gap-6">
        <a href="https://github.com/ouroborosbot/ouroboros-website/blob/main/scripts/model-reviews.cjs" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-2.5 bg-scale text-void text-sm font-medium rounded-lg transition-all duration-300 hover:bg-glow hover:shadow-[0_0_30px_rgba(45,148,71,0.15)]">
          View the script on GitHub
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
        <a href="/" class="text-mist hover:text-bone transition-colors text-sm">&#8592; Back to home</a>
      </div>
    </div>
  </section>
</Layout>
