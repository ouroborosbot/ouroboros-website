---
import Layout from '../../layouts/Layout.astro'
import modelReviews from '../../data/model-reviews.json'
import { parseInlineMd } from '../../lib/md'

import anthropicTranscript from '../../data/model-reviews-transcripts/anthropic.json'
import openaiTranscript from '../../data/model-reviews-transcripts/openai.json'
import geminiTranscript from '../../data/model-reviews-transcripts/gemini.json'
import minimaxTranscript from '../../data/model-reviews-transcripts/minimax.json'

const transcripts: Record<string, any> = {
  anthropic: anthropicTranscript,
  openai: openaiTranscript,
  gemini: geminiTranscript,
  minimax: minimaxTranscript,
}

export function getStaticPaths() {
  return [
    { params: { provider: 'anthropic' } },
    { params: { provider: 'openai' } },
    { params: { provider: 'gemini' } },
    { params: { provider: 'minimax' } },
  ]
}

const { provider } = Astro.params
const transcript = transcripts[provider as string]
const review = modelReviews.reviews.find((r) => r.provider === provider)

if (!transcript || !review) {
  return Astro.redirect('/model-reviews')
}

const generatedDate = new Date(transcript.generated).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })

function truncate(s: string, n: number): string {
  if (!s) return ''
  if (s.length <= n) return s
  return s.slice(0, n) + '…'
}
---

<Layout
  title={`${review.displayName} — review transcript — Ouroboros`}
  description={`Full transcript of ${review.displayName}'s evaluation: ${review.rounds} rounds of research across ${review.searchCount} searches and ${review.fetchCount} URL fetches.`}
>
  <!-- ═══════════════ HEADER ═══════════════ -->
  <section class="relative overflow-hidden px-6 md:px-12 lg:px-24 pt-32 pb-12 md:pt-40 md:pb-16">
    <div class="absolute inset-0 bg-gradient-to-b from-deep via-undergrowth/10 to-void pointer-events-none"></div>

    <div class="relative max-w-5xl mx-auto">
      <a href="/model-reviews" class="inline-flex items-center gap-2 font-mono text-[10px] text-shadow uppercase tracking-[0.25em] hover:text-scale transition-colors mb-8">
        &#8592; All reviews
      </a>

      <div class="flex items-center gap-3 mb-6">
        <span class="font-mono text-[10px] text-fang uppercase tracking-[0.3em]">{review.vendor}</span>
        <span class="h-px flex-1 bg-canopy/40 max-w-[100px]"></span>
        <span class="font-mono text-[9px] text-shadow uppercase tracking-[0.2em]">{generatedDate}</span>
      </div>

      <h1 class="font-display text-bone leading-[0.95] text-[2rem] sm:text-[2.75rem] md:text-[4rem] mb-3">
        {review.displayName}
      </h1>
      <div class="font-mono text-xs text-shadow tracking-wider mb-10">{review.model}</div>

      <!-- Stats row -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-12 max-w-2xl">
        <div class="border-l-2 border-canopy/40 pl-4">
          <div class="font-display text-bone text-2xl md:text-3xl">{review.rounds}</div>
          <div class="font-mono text-[9px] text-shadow uppercase tracking-[0.2em] mt-1">Rounds</div>
        </div>
        <div class="border-l-2 border-canopy/40 pl-4">
          <div class="font-display text-bone text-2xl md:text-3xl">{review.searchCount}</div>
          <div class="font-mono text-[9px] text-shadow uppercase tracking-[0.2em] mt-1">Searches</div>
        </div>
        <div class="border-l-2 border-canopy/40 pl-4">
          <div class="font-display text-bone text-2xl md:text-3xl">{review.fetchCount}</div>
          <div class="font-mono text-[9px] text-shadow uppercase tracking-[0.2em] mt-1">Fetches</div>
        </div>
        <div class="border-l-2 border-scale/60 pl-4">
          <div class="font-display text-scale text-2xl md:text-3xl">{review.verdict}</div>
          <div class="font-mono text-[9px] text-shadow uppercase tracking-[0.2em] mt-1">Verdict</div>
        </div>
      </div>

      <!-- The testimonial as quote — parseInlineMd renders code spans + bold -->
      <blockquote class="border-l-2 border-scale/60 pl-6 md:pl-8 py-2">
        <p class="text-bone text-lg md:text-xl lg:text-2xl leading-[1.65] font-light" set:html={`&#8220;${parseInlineMd(review.testimonial)}&#8221;`}></p>
      </blockquote>
    </div>
  </section>

  <!-- ═══════════════ TRANSCRIPT ═══════════════ -->
  <section class="relative px-6 md:px-12 lg:px-24 py-16 md:py-24">
    <div class="relative max-w-5xl mx-auto">
      <div class="flex items-baseline gap-3 mb-12">
        <span class="font-mono text-[10px] text-fang uppercase tracking-[0.3em]">The transcript</span>
        <span class="h-px flex-1 bg-canopy/40"></span>
      </div>

      <div class="space-y-10">
        {transcript.rounds.map((round: any) => (
          <div class="grid grid-cols-[auto_1fr] gap-5 md:gap-8">
            <!-- Round number -->
            <div class="flex-none">
              <div class="font-display text-canopy text-3xl md:text-4xl leading-none">{String(round.round).padStart(2, '0')}</div>
              <div class="font-mono text-[9px] text-shadow uppercase tracking-[0.2em] mt-1">Round</div>
            </div>

            <!-- Round content -->
            <div class="min-w-0">
              {round.thinking && (
                <div class="mb-5">
                  <div class="font-mono text-[9px] text-shadow uppercase tracking-[0.2em] mb-2">Thinking</div>
                  <p class="text-mist text-[1.0625rem] md:text-lg leading-[1.65]">{round.thinking}</p>
                </div>
              )}

              {round.actions && round.actions.length > 0 && (
                <div class="space-y-4">
                  {round.actions.map((action: any) => (
                    <div>
                      {action.type === 'fetch' && (
                        <details class="border border-canopy/40 bg-deep/30 backdrop-blur-sm group">
                          <summary class="cursor-pointer p-4 md:p-5 list-none flex items-baseline gap-3 hover:bg-deep/50 transition-colors">
                            <span class="font-mono text-[9px] text-glow uppercase tracking-[0.2em] flex-none">Fetch</span>
                            <span class="font-mono text-xs text-bone break-all min-w-0 flex-1">{action.url}</span>
                            <span class="font-mono text-[9px] text-shadow tracking-wider flex-none">{action.resultLength} chars</span>
                          </summary>
                          <div class="px-4 md:px-5 pb-5 pt-2 border-t border-canopy/30">
                            <pre class="font-mono text-[11px] md:text-xs text-mist leading-relaxed whitespace-pre-wrap break-words">{truncate(action.result, 4000)}</pre>
                          </div>
                        </details>
                      )}

                      {action.type === 'search' && (
                        <details class="border border-canopy/40 bg-deep/30 backdrop-blur-sm group">
                          <summary class="cursor-pointer p-4 md:p-5 list-none flex items-baseline gap-3 hover:bg-deep/50 transition-colors">
                            <span class="font-mono text-[9px] text-scale uppercase tracking-[0.2em] flex-none">Search</span>
                            <span class="font-mono text-xs text-bone break-words min-w-0 flex-1">{action.query}</span>
                          </summary>
                          <div class="px-4 md:px-5 pb-5 pt-2 border-t border-canopy/30">
                            <pre class="font-mono text-[11px] md:text-xs text-mist leading-relaxed whitespace-pre-wrap break-words">{truncate(action.result, 4000)}</pre>
                          </div>
                        </details>
                      )}

                      {action.type === 'verdict' && (
                        <div class="border border-scale/40 bg-scale/[0.04] backdrop-blur-sm p-5 md:p-6">
                          <div class="font-mono text-[9px] text-scale uppercase tracking-[0.25em] mb-3">Final verdict</div>
                          <div class="font-display text-scale text-2xl md:text-3xl mb-4">{action.verdict}</div>
                          <p class="text-bone text-base md:text-[1.0625rem] leading-[1.7]" set:html={`&#8220;${parseInlineMd(action.testimonial)}&#8221;`}></p>
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════ FOOTER NAV ═══════════════ -->
  <section class="relative px-6 md:px-12 lg:px-24 py-12 md:py-16">
    <div class="max-w-5xl mx-auto flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-4">
      <a href="/model-reviews" class="inline-flex items-center gap-2 text-bone font-medium hover:text-scale transition-colors">
        &#8592; Back to all reviews
      </a>
      <a href="https://github.com/ouroborosbot/ouroboros-website/blob/main/scripts/model-reviews.cjs" target="_blank" rel="noopener noreferrer" class="text-mist hover:text-bone transition-colors text-sm">
        View the script on GitHub &#8594;
      </a>
    </div>
  </section>
</Layout>
