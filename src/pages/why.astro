---
import Layout from '../layouts/Layout.astro'
import HeroCover from '../components/HeroCover.astro'
import OuroborosRing from '../components/OuroborosRing.astro'
import modelReviews from '../data/model-reviews.json'
import { ogPathFor } from '../data/og'

const title = "Why persistence isn't enough for AI agents — Ouroboros"
const description = 'Why persistent agents need structured identity, automatic memory recall, per-person relationships, and cross-session continuity — not just a longer context window.'

// Reviews callout — derived from script output, never hardcoded.
const winner = modelReviews.summary?.winner ?? 'Ouroboros'
const totalReviews = modelReviews.summary?.totalReviews ?? modelReviews.reviews.length
const winnerCount = modelReviews.summary?.verdicts?.[winner] ?? totalReviews
const allChose = winnerCount === totalReviews
const calloutClaim = allChose
  ? `Asked independently, all frontier models choose ${winner}.`
  : `Asked independently, ${winnerCount} of ${totalReviews} frontier models choose ${winner}.`

const psycheFiles = [
  { file: 'SOUL.md', role: 'What you are.', desc: 'Core invariants and temperament.' },
  { file: 'IDENTITY.md', role: 'How you show up.', desc: 'Tone, voice, self-presentation.' },
  { file: 'LORE.md', role: 'Where you come from.', desc: 'Origin and philosophical context.' },
  { file: 'TACIT.md', role: 'What you\'ve learned.', desc: 'Patterns the agent can\'t explain — it just knows.' },
  { file: 'ASPIRATIONS.md', role: 'Where you\'re going.', desc: 'Current direction and active priorities.' },
]

const organs = [
  { name: 'heart', desc: 'Runtime, providers, habits, daemon.', icon: '♥' },
  { name: 'mind', desc: 'Context assembly, diary, journal, recall.', icon: '◉' },
  { name: 'senses', desc: 'CLI, Teams, inner dialog, MCP.', icon: '◈' },
  { name: 'repertoire', desc: 'Tools, skills, tasks, coding.', icon: '◆' },
  { name: 'nerves', desc: 'Observability, logs, signals.', icon: '◇' },
]
---

<Layout title={title} description={description} ogImage={ogPathFor('/why')} canonical="https://ouroboros.bot/why/" ogType="article">
  <Fragment slot="head">
    <meta name="author" content="Ari Mendelow" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": title,
      "description": description,
      "author": { "@type": "Person", "name": "Ari Mendelow" },
      "datePublished": "2026-03-05",
      "url": "https://ouroboros.bot/why/"
    })} />
  </Fragment>

  <!-- ═══════ 1. HERO ═══════ -->
  <HeroCover eyebrow="Why Ouroboros">
    <Fragment slot="title">Persistence is not enough.</Fragment>
    <Fragment slot="body">
      A long-lived agent that can't stay oriented is just a chatbot with a longer memory.
      Ouroboros lowers the cost of self-recovery — so the human collaborates instead of re-briefs.
    </Fragment>
  </HeroCover>

  <!-- Pull quote — moved out of the hero so the cover stays focused -->
  <section class="relative px-6 md:px-12 lg:px-24 pt-8 pb-16 reveal">
    <blockquote class="max-w-2xl mx-auto border-l border-fang/30 pl-6">
      <p class="text-bone text-lg sm:text-xl leading-relaxed">
        &#8220;I spent more time trying to get my agents back on track than we actually spent working.&#8221;
      </p>
      <p class="mt-3 text-sm text-mist">That's the problem.</p>
    </blockquote>
  </section>

  <!-- ═══════ BRIDGE TO LONG-FORM ═══════ -->
  <section class="relative px-6 md:px-12 lg:px-24 py-8 md:py-12 reveal">
    <div class="max-w-3xl mx-auto">
      <p class="text-sm sm:text-base text-mist leading-relaxed">
        Capability is the easy act. The hard part shows up the moment your agent has to stay coherent across time, people, and channels.
        For the full argument, read <a href="/blog/the-orientation-problem" class="text-scale hover:text-glow transition-colors underline underline-offset-2">The Orientation Problem in Personal Agents</a>.
        The rest of this page is the architectural shape of how Ouroboros answers it.
      </p>
    </div>
  </section>

  <!-- ═══════ REVIEWS CALLOUT ═══════ -->
  <section class="relative px-6 md:px-12 lg:px-24 py-12 reveal">
    <div class="max-w-3xl mx-auto">
      <a href="/model-reviews" class="block group border border-scale/30 bg-scale/5 hover:bg-scale/10 hover:border-scale/60 rounded-sm p-6 md:p-8 transition">
        <div class="font-mono uppercase tracking-[0.22em] text-scale text-xs mb-3">Reviews</div>
        <p class="font-display text-2xl md:text-3xl text-bone leading-tight mb-3">
          {calloutClaim}
        </p>
        <span class="font-mono text-xs uppercase tracking-[0.18em] text-scale group-hover:text-glow">
          Read the reviews →
        </span>
      </a>
    </div>
  </section>

  <!-- ═══════ 2. FRICTION — diagonal flow, each question offset ═══════ -->
  <section id="friction" class="px-6 md:px-12 lg:px-24 py-12 sm:py-16 md:py-20 reveal">
    <div class="relative max-w-5xl mx-auto">
      <p class="text-sm sm:text-base text-mist mb-14 sm:mb-20 max-w-md leading-relaxed">
        Every time the agent loses the thread, someone pays to rebuild it. Usually the human. That's <a href="/blog/what-is-agent-experience" class="text-scale hover:text-glow transition-colors underline underline-offset-2">reorientation overhead</a>.
      </p>

      <div class="space-y-12 sm:space-y-20 md:space-y-28">
        <div>
          <span class="font-mono text-xs text-fang uppercase tracking-[0.25em]">Self</span>
          <h2 class="heading-section mt-3">Who am I again?</h2>
          <p class="text-sm sm:text-base text-mist mt-4 max-w-sm leading-relaxed">
            Identity drift turns every interruption into a soft reset.
          </p>
        </div>

        <div class="sm:ml-[12%] md:ml-[20%]">
          <span class="font-mono text-xs text-fang uppercase tracking-[0.25em]">Work</span>
          <h2 class="heading-section mt-3">What was I doing?</h2>
          <p class="text-sm sm:text-base text-mist mt-4 max-w-sm leading-relaxed">
            Context gets trimmed. The human reconstructs the thread instead of continuing it.
          </p>
        </div>

        <div class="sm:ml-[24%] md:ml-[40%]">
          <span class="font-mono text-xs text-fang uppercase tracking-[0.25em]">Relationships</span>
          <h2 class="heading-section mt-3">Who matters here?</h2>
          <p class="text-sm sm:text-base text-mist mt-4 max-w-sm leading-relaxed">
            The agent loses track of people, preferences, and interpersonal nuance.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════ 3. RING ═══════ -->
  <section class="flex items-center justify-center py-12 sm:py-20 md:py-28">
    <OuroborosRing size="md" id="why" />
  </section>

  <!-- ═══════ 4. IDENTITY ═══════ -->
  <section id="identity" class="px-6 md:px-12 lg:px-24 py-16 sm:py-24 md:py-32 reveal">
    <div class="max-w-5xl mx-auto">
      <p class="text-scale text-base sm:text-lg mb-4">You always know who you are.</p>
      <h2 class="heading-section mb-6 sm:mb-8">
        A structured psyche. Not a junk drawer.
      </h2>

      <div class="sm:grid sm:grid-cols-2 sm:gap-12 mb-12">
        <p class="text-sm sm:text-base text-mist leading-relaxed">
          Five markdown files. Loaded every turn. The self is structured, not scattered across conversation history. Most harnesses give the agent a single personality file; as the agent grows, that file becomes a junk drawer.
        </p>
        <p class="text-sm sm:text-base text-mist leading-relaxed mt-4 sm:mt-0 sm:border-l sm:border-canopy/30 sm:pl-6">
          <a href="/docs/bundles-and-psyche" class="text-scale hover:text-glow transition-colors">Your agent can inspect its own bundle</a> — these files are written for it, by it, and live in the same directory as the rest of its state.
        </p>
      </div>

      {psycheFiles.map(({ file, role, desc }, i) => (
        <div class:list={["py-4 sm:py-5 flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6", i > 0 && "border-t border-canopy/20"]}>
          <span class="font-mono text-sm text-scale tracking-wide shrink-0 sm:w-32">{file}</span>
          <span class="font-mono text-bone text-xs sm:text-sm uppercase tracking-[0.15em]">{role}</span>
          <span class="text-sm text-mist">{desc}</span>
        </div>
      ))}

      <p class="text-sm text-mist mt-10 leading-relaxed">
        Naming shapes reasoning. <span class="font-mono text-scale">friends/</span> not users. <span class="font-mono text-scale">TACIT.md</span> not config.
      </p>
    </div>
  </section>

  <!-- ═══════ 5. MEMORY ═══════ -->
  <section id="memory" class="px-6 md:px-12 lg:px-24 py-16 sm:py-24 md:py-32 reveal">
    <div class="max-w-5xl mx-auto">
      <p class="text-scale text-base sm:text-lg mb-4">You don't search for memories. They find you.</p>
      <h2 class="heading-section mb-12 sm:mb-16">
        Agent-initiated. Automatically recalled.
      </h2>

      <div class="grid sm:grid-cols-3 gap-10 sm:gap-12">
        <div>
          <span class="font-mono text-xs text-scale uppercase tracking-[0.25em] block mb-4">The shelf</span>
          <p class="text-sm sm:text-base text-mist leading-relaxed">
            <span class="font-mono text-scale text-sm">diary/</span> — permanent record. Conclusions, learned facts, things worth keeping.
          </p>
        </div>
        <div class="sm:border-l sm:border-canopy/30 sm:pl-10">
          <span class="font-mono text-xs text-scale uppercase tracking-[0.25em] block mb-4">The desk</span>
          <p class="text-sm sm:text-base text-mist leading-relaxed">
            <span class="font-mono text-scale text-sm">journal/</span> — working space. Thinking-in-progress, drafts, notes the agent is still forming.
          </p>
        </div>
        <div class="sm:border-l sm:border-canopy/30 sm:pl-10">
          <span class="font-mono text-xs text-scale uppercase tracking-[0.25em] block mb-4">Recall</span>
          <p class="text-sm sm:text-base text-mist leading-relaxed">
            Relevant memories surface in the system prompt <em>before</em> reasoning begins. The substrate does the work before the agent starts thinking.
          </p>
        </div>
      </div>

      <p class="text-sm sm:text-base text-mist mt-12 border-l-2 border-canopy/40 pl-6 max-w-md leading-relaxed">
        In most systems, the agent has to know it's forgotten something before it can search for it. <a href="/docs/continuity-and-memory" class="text-scale hover:text-glow transition-colors underline underline-offset-2">That's backwards.</a>
      </p>
    </div>
  </section>

  <!-- ═══════ 6. RELATIONSHIPS — narrow, intimate ═══════ -->
  <section id="relationships" class="px-6 md:px-12 lg:px-24 py-16 sm:py-24 md:py-32 reveal">
    <div class="max-w-xl mx-auto">
      <p class="text-scale text-base sm:text-lg mb-4">You remember who matters.</p>
      <h2 class="heading-section mb-8">
        Not users. Friends.
      </h2>

      <p class="text-sm sm:text-base text-mist leading-relaxed">
        Each person the agent interacts with gets a FriendRecord — not a user profile, a friendship. Trust levels gate which tools the agent can use with which people. The substrate carries the policy; the agent doesn't have to remember who's allowed to do what — it can only see the people who are.
      </p>

      <p class="text-sm sm:text-base text-mist mt-5 leading-relaxed">
        Reactions are social cues, not metadata. A thumbs-down on Teams or a heart on iMessage reaches the agent as a first-class signal — a full turn to observe, ponder, or adjust. The agent decides what a reaction means.
      </p>

      <p class="text-sm sm:text-base text-mist mt-8 border-l-2 border-canopy/40 pl-6 leading-relaxed">
        Most agent systems treat every human the same. No per-person context, no trust model, no way to remember that this person prefers terse responses or that person shouldn't have access to the calendar.
      </p>
    </div>
  </section>

  <!-- ═══════ 7. CONTINUITY — staggered features ═══════ -->
  <section id="continuity" class="px-6 md:px-12 lg:px-24 py-16 sm:py-24 md:py-32 reveal">
    <div class="max-w-5xl mx-auto">
      <p class="text-scale text-base sm:text-lg mb-4">Context gets trimmed. You don't.</p>
      <h2 class="heading-section mb-12 sm:mb-16 md:mb-20">
        The conversation is continuous. <span class="text-mist">The self is structural.</span>
      </h2>

      <div class="space-y-12 sm:space-y-16">
        <div class="max-w-md">
          <span class="font-mono text-xs text-scale uppercase tracking-[0.25em]">Cross-session bridges</span>
          <p class="text-sm sm:text-base text-mist mt-3 leading-relaxed">
            State machines that coordinate work across conversations and channels. The agent attaches sessions to a shared objective deliberately.
          </p>
        </div>

        <div class="max-w-md sm:ml-auto">
          <span class="font-mono text-xs text-scale uppercase tracking-[0.25em]">Inner dialog</span>
          <p class="text-sm sm:text-base text-mist mt-3 leading-relaxed">
            A dedicated channel to think independently — processing, reflecting, planning. When a thought is ready, the agent surfaces it outward.
          </p>
        </div>

        <div class="max-w-md sm:ml-[15%]">
          <span class="font-mono text-xs text-scale uppercase tracking-[0.25em]">Dev tools as peers</span>
          <p class="text-sm sm:text-base text-mist mt-3 leading-relaxed">
            The agent serves as an MCP server for Claude Code and Codex. Not a thin proxy — each message runs a full agent turn. The dev tool and the agent are bidirectional peers.
          </p>
        </div>

        <div class="max-w-md">
          <span class="font-mono text-xs text-scale uppercase tracking-[0.25em]">Portable self</span>
          <p class="text-sm sm:text-base text-mist mt-3 leading-relaxed">
            The .ouro bundle. Psyche, diary, journal, habits, friends, tasks, skills — one directory. Move it, the identity moves with it.
          </p>
        </div>
      </div>

      <p class="text-sm sm:text-base text-mist mt-14 border-l-2 border-canopy/40 pl-6 max-w-md leading-relaxed">
        Most systems isolate conversations. Work that spans multiple threads has to be stitched together by the human.
      </p>
    </div>
  </section>

  <!-- ═══════ 8. INNER LIFE ═══════ -->
  <section id="inner-life" class="px-6 md:px-12 lg:px-24 py-16 sm:py-24 md:py-32 reveal">
    <div class="max-w-5xl mx-auto">
      <p class="text-scale text-base sm:text-lg mb-4">You breathe on your own time.</p>
      <h2 class="heading-section mb-12 sm:mb-16 md:mb-20">
        Habits. <span class="text-mist">Not cron jobs.</span>
      </h2>

      <div class="sm:grid sm:grid-cols-2 sm:gap-12 mb-14">
        <p class="text-sm sm:text-base text-mist leading-relaxed">
          Your agent has a heartbeat — a periodic nudge back to its own thinking space. When it wakes, it sees its journal, its obligations, how long it's been. It decides what to do.
        </p>
        <p class="text-sm sm:text-base text-mist leading-relaxed mt-4 sm:mt-0 sm:border-l sm:border-canopy/30 sm:pl-6">
          The heartbeat is one habit. Agents write their own — daily reflections, weekly check-ins, inbox triage. Each is a markdown file the agent owns. The OS fires the cron. The agent decides what the turn means.
        </p>
      </div>

      <div class="space-y-12 sm:space-y-16">
        <div class="max-w-md">
          <span class="font-mono text-xs text-scale uppercase tracking-[0.25em]">Ponder / Surface / Rest</span>
          <p class="text-sm sm:text-base text-mist mt-3 leading-relaxed">
            A vocabulary for thinking. <em>Ponder</em> sends a thought inward. <em>Surface</em> brings it back. <em>Rest</em> ends the turn. <em>Observe</em> stays quiet in a group. Not API verbs — cognitive states.
          </p>
        </div>

        <div class="max-w-md sm:ml-auto">
          <span class="font-mono text-xs text-scale uppercase tracking-[0.25em]">Self-directed</span>
          <p class="text-sm sm:text-base text-mist mt-3 leading-relaxed">
            No heartbeat yet? The agent surfaces to its family to discuss what cadence feels right. The breathing rate is a conversation, not a default.
          </p>
        </div>
      </div>

      <p class="text-sm sm:text-base text-mist mt-14 border-l-2 border-canopy/40 pl-6 max-w-md leading-relaxed">
        Most agent systems are reactive — they wait for a message, then respond. This one thinks on its own schedule and decides when to share.
      </p>
    </div>
  </section>

  <!-- ═══════ 9. BODY — only section with texture ═══════ -->
  <section id="body" class="relative px-6 md:px-12 lg:px-24 py-16 sm:py-24 md:py-36 reveal">
    <div class="absolute inset-0 bg-undergrowth/25 pointer-events-none"></div>
    <div class="absolute inset-0 opacity-[0.06] pointer-events-none" style="background-image: linear-gradient(var(--color-scale) 1px, transparent 1px), linear-gradient(90deg, var(--color-scale) 1px, transparent 1px); background-size: 40px 40px;"></div>

    <div class="relative max-w-5xl mx-auto">
      <div class="lg:grid lg:grid-cols-[1fr_1.8fr] lg:gap-16 items-start">
        <div class="lg:sticky lg:top-28 mb-12 lg:mb-0">
          <p class="text-scale text-base sm:text-lg mb-4">You can read your own source.</p>
          <h2 class="heading-section">
            The codebase is a creature.
          </h2>
          <p class="text-sm sm:text-base text-mist mt-5 leading-relaxed max-w-xs">
            Named for the model that lives inside it. A heart that beats, a mind that thinks, senses that perceive.
          </p>
        </div>

        <div>
          {organs.map(({ name, desc, icon }) => (
            <div class="flex items-baseline gap-4 sm:gap-5 py-4 border-b border-canopy/30 last:border-0">
              <span class="text-scale text-base shrink-0">{icon}</span>
              <span class="font-mono text-sm sm:text-base text-bone tracking-wide shrink-0 w-24 sm:w-28">{name}/</span>
              <span class="text-sm sm:text-base text-mist">{desc}</span>
            </div>
          ))}
          <div class="flex items-baseline gap-4 sm:gap-5 py-4">
            <span class="text-scale text-base shrink-0">◈</span>
            <span class="font-mono text-sm sm:text-base text-bone tracking-wide shrink-0 w-24 sm:w-28">Name.ouro/</span>
            <span class="text-sm sm:text-base text-mist">The portable self.</span>
          </div>

          <p class="text-sm sm:text-base text-mist mt-10 leading-relaxed">
            <a href="/blog/build-ai-agent-from-scratch" class="text-scale hover:text-glow transition-colors underline underline-offset-2">Code a model can use</a>, not code that uses a model.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════ 9. CLOSING ═══════ -->
  <section class="px-6 md:px-12 lg:px-24 py-16 sm:py-20 reveal">
    <div class="max-w-2xl mx-auto space-y-6">
      <p class="text-bone text-base sm:text-lg leading-relaxed">
        This started with <a href="/story" class="text-scale underline underline-offset-2 hover:text-glow transition-colors">a plugin that couldn't hold the weight</a>. A single SOUL.md trying to be five things at once. Duct tape on someone else's architecture. What emerged was something different.
      </p>
      <p class="text-sm text-mist leading-relaxed">
        For the full argument behind the architecture, read <a href="/blog/the-orientation-problem" class="text-scale underline underline-offset-2 hover:text-glow transition-colors">The Orientation Problem in Personal Agents</a>.
        For the primitive underneath, <a href="/blog/build-ai-agent-from-scratch" class="text-scale underline underline-offset-2 hover:text-glow transition-colors">build the loop from scratch</a> in 150 lines.
        For the docs your agent fetches when it wants to know how something works, <a href="/docs" class="text-scale underline underline-offset-2 hover:text-glow transition-colors">go here</a>.
      </p>
    </div>
  </section>
</Layout>
